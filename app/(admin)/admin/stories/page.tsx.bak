import Link from "next/link";
import { sql } from "@/lib/db/client";

export const dynamic = "force-dynamic";

export default async function AdminStoriesPage() {
  const stories = await sql`
    SELECT id, slug, title, category, status, updated_at
    FROM stories
    ORDER BY updated_at DESC
  `;

  return (
    <section className="mx-auto max-w-7xl">
      <div className="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p className="text-xs font-bold uppercase tracking-[0.16em] text-emerald-800">Content</p>
          <h1 className="mt-2 text-3xl font-black tracking-tight text-slate-900">Stories</h1>
          <p className="mt-2 text-sm text-slate-500">Manage community stories and program updates.</p>
        </div>
        <span className="rounded-xl bg-emerald-800 px-4 py-3 text-center text-sm font-bold text-white">
          {stories.length} stories
        </span>
      </div>

      <div className="mt-7 overflow-hidden rounded-2xl border border-slate-200 bg-white">
        <div className="overflow-x-auto">
          <table className="w-full min-w-[720px] text-left text-sm">
            <thead className="border-b border-slate-200 bg-slate-50 text-xs uppercase tracking-wide text-slate-500">
              <tr>
                <th className="px-5 py-4 font-bold">Story</th>
                <th className="px-5 py-4 font-bold">Category</th>
                <th className="px-5 py-4 font-bold">Status</th>
                <th className="px-5 py-4 font-bold">Last updated</th>
                <th className="px-5 py-4 font-bold">View</th>
              </tr>
            </thead>
            <tbody className="divide-y divide-slate-100">
              {stories.map((story) => (
                <tr key={String(story.id)} className="hover:bg-slate-50/70">
                  <td className="px-5 py-4">
                    <p className="font-bold text-slate-900">{story.title as string}</p>
                    <p className="mt-1 text-xs text-slate-400">{story.slug as string}</p>
                  </td>
                  <td className="px-5 py-4 text-slate-600">{story.category as string}</td>
                  <td className="px-5 py-4">
                    <span className={`rounded-full px-2.5 py-1 text-xs font-bold ${
                      story.status === "published"
                        ? "bg-emerald-50 text-emerald-800"
                        : story.status === "draft"
                          ? "bg-amber-50 text-amber-800"
                          : "bg-slate-100 text-slate-600"
                    }`}>
                      {story.status as string}
                    </span>
                  </td>
                  <td className="px-5 py-4 text-slate-500">
                    {new Date(String(story.updated_at)).toLocaleDateString("en-GB")}
                  </td>
                  <td className="px-5 py-4">
                    <Link href={`/stories/${story.slug}`} target="_blank" className="font-semibold text-emerald-800 hover:underline">
                      Preview
                    </Link>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {stories.length === 0 && (
          <p className="p-8 text-center text-sm text-slate-500">No stories found.</p>
        )}
      </div>
    </section>
  );
}
